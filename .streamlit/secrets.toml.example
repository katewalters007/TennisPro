# Optional: persistent hosted PostgreSQL for production or Streamlit Cloud.
# Leave unset to use the local SQLite fallback.
DATABASE_URL = "postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres?sslmode=require"

# Streamlit secrets example for MFA email delivery
# Copy this file to .streamlit/secrets.toml and fill with real values.

SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USERNAME = "your_email@gmail.com"
SMTP_PASSWORD = "your_app_password"
SMTP_FROM_EMAIL = "your_email@gmail.com"
SMTP_USE_TLS = "true"

# Security hardening values
APP_ENCRYPTION_KEY = "replace_with_fernet_key"
VERIFICATION_CODE_PEPPER = "replace_with_long_random_secret"
